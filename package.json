{
  "name": "@worldcoin/nucleus-monorepo",
  "version": "0.2.16",
  "private": true,
  "description": "Design tokens for the World ecosystem (source repo; the published package is built into build/web)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "icons:download": "node --import tsx tokens/import/download-icons.ts",
    "icons:import": "node --import tsx tokens/import/figma-icons.ts",
    "test": "node --import tsx --test tokens/formats/icons-android.test.ts tokens/import/icon-import.test.ts tokens/import/sync-report.test.ts",
    "build": "npm run clean && tsx tokens/build/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.json\"",
    "format:check": "prettier --check \"**/*.json\"",
    "clean": "rm -rf build"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "svgpath": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "oxlint": "^1.51.0",
    "prettier": "^3.8.1",
    "svgo": "4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
